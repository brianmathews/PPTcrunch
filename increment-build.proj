<Project>
  <Import Project="Version.props" />
  <Target Name="IncrementBuildNumber">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(BuildNumber)', '^\d+$'))"
           Text="build-number.txt must contain a nonnegative integer." />
    <Error Condition="$(BuildNumber) &gt;= 65534"
           Text="Build number exhausted. Increase the release version in Version.props and reset build-number.txt to 0." />
    <PropertyGroup>
      <NextBuildNumber>$([MSBuild]::Add($(BuildNumber), 1))</NextBuildNumber>
    </PropertyGroup>
    <WriteLinesToFile File="$(MSBuildThisFileDirectory)build-number.txt"
                      Lines="$(NextBuildNumber)" Overwrite="true" Encoding="UTF-8" />
    <Message Importance="high" Text="Publishing PPTcrunch $(VersionPrefix).$(NextBuildNumber)" />
  </Target>
</Project>
